# Template for the app's secrets - shows the exact shape to fill in.
#
# LOCAL USE: copy this file to .streamlit/secrets.toml (same folder) and
# fill in real values. That file is gitignored, so it's safe to put real
# secrets there - never edit or commit THIS .example file with real values.
#
# HOSTED USE (Streamlit Community Cloud): don't upload secrets.toml at
# all. Instead paste this same content, with real values filled in, into
# your app's Settings > Secrets panel on share.streamlit.io.

# A shared password anyone opening the app link must enter. Pick
# anything - just tell the people you share the link with what it is.
app_password = "change-me"

# Shown on every row of the report. Kept out of the (public) source code
# on purpose - set these here instead of editing build_trip_report.py.
supplier_name = "Your Broker Name"
contract_id = "YOUR-CONTRACT-ID"

# The full contents of your Google service account's JSON key file,
# reshaped as TOML. Get these values from the .json file you downloaded
# in Google Cloud Console (IAM & Admin > Service Accounts > your account
# > Keys > Add Key > Create new key > JSON) - copy each field over.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
